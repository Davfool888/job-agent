APP_NAME=job-agent
# Cuenta administradora: unica que ve/edita el perfil base global.
# Otros usuarios con sesion usan su propio perfil (empieza en blanco).
ADMIN_EMAIL=davfool888@gmail.com
DATABASE_URL=sqlite:///./data/job_agent.db
# Motor de persistencia: sqlite (local, defecto) o firestore (nube).
DB_BACKEND=sqlite
FIREBASE_PROJECT_ID=job-agent-davfo
FIRESTORE_DATABASE=(default)
# Ruta al JSON de la cuenta de servicio (jamas al repo; ver database/.env.example).
GOOGLE_APPLICATION_CREDENTIALS=backend/.secrets/firebase-service-account.json
# En Render NO hay archivo: usa el JSON en base64 de una sola linea
# (recomendado) o el JSON inline. Solo una de las tres hace falta.
# FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# SMMLV vigente en COP para bandas salariales (actualizar cada enero).
SMMLV_COP=1423500
# Si se define (cualquier valor), silencia el warning de arranque sobre
# SQLite efimero. Solo para desarrollo local consciente.
# ALLOW_EPHEMERAL_SQLITE=1
COMPUTRABAJO_BASE_URL=https://co.computrabajo.com
MAGNETO_BASE_URL=https://www.magneto365.com
ELEMPLEO_BASE_URL=https://www.elempleo.com
INDEED_BASE_URL=https://co.indeed.com
LINKEDIN_BASE_URL=https://www.linkedin.com
GEMINI_API_KEY=
# Scheduler de busqueda automatica (seccion "Busqueda").
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Secreto opcional para POST /scheduler/tick desde un cron externo.
# Si se define, el tick exige ?secret= o header X-Cron-Secret.
SCHEDULER_CRON_SECRET=
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36
