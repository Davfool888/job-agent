# Job Agent - Variables de entorno (ejemplo)
# Copia este archivo a .env (raíz) y/o backend/.env
# backend/.env tiene prioridad sobre el de la raíz

# ==========================================
# APLICACIÓN
# ==========================================
APP_NAME=job-agent

# ==========================================
# BASE DE DATOS
# ==========================================
# Motor: sqlite (local) | firestore (cloud)
DB_BACKEND=sqlite
# SQLite (local):
DATABASE_URL=sqlite:///data/job_agent.db
# Firestore (cloud) - descomenta y configura:
# DB_BACKEND=firestore
# FIREBASE_PROJECT_ID=tu-proyecto-firebase
# FIRESTORE_DATABASE=(default)
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/firebase-key.json

# ==========================================
# AUTENTICACIÓN / ADMIN
# ==========================================
# Solo este email puede editar base_cv.json global
ADMIN_EMAIL=tu@email.com

# ==========================================
# CORS - Orígenes del frontend
# ==========================================
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tu-frontend.vercel.app

# ==========================================
# FUENTES DE EMPLEO (scrapers)
# ==========================================
COMPUTRABAJO_ENABLED=true
LINKEDIN_ENABLED=true
# ELEMPLEO_ENABLED=false
# INDEED_ENABLED=false
# MAGNETO_ENABLED=false

# URLs base (por si cambian)
COMPUTRABAJO_BASE_URL=https://co.computrabajo.com
LINKEDIN_BASE_URL=https://www.linkedin.com

# ==========================================
# IA - Proveedores (orden de fallback)
# ==========================================
# Gemini (gratis con API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI-compatible (OpenAI, OpenRouter, etc.)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=gpt-4o-mini

# Orden de intento: gemini → openai_compat → rule_based
AI_PROVIDER_ORDER=gemini,openai_compat,rule_based
AI_TIMEOUT_SECONDS=30

# ==========================================
# MATCHING - Pesos (suman 100)
# ==========================================
MATCH_W_TITLE=20
MATCH_W_SKILLS=30
MATCH_W_RESPONSIBILITIES=30
MATCH_W_TOOLS=20

# ==========================================
# CV - Umbrales de generación
# ==========================================
# score >= 75 → genera automáticamente
CV_GENERATION_THRESHOLD=75
# 50 <= score < 75 → requiere revisión (solo con force=true)
CV_REVIEW_THRESHOLD=50

# ==========================================
# SCHEDULER - Búsqueda automática
# ==========================================
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Secreto para cron externo (cron-job.org). Si vacío, endpoint público.
SCHEDULER_CRON_SECRET=

# ==========================================
# ADAPTAR-PERFIL (HTML → PDF con Chromium)
# ==========================================
# Pulido del resumen con LLM (true = consume IA, false = 100% local)
ADAPT_LLM_ENABLED=false
# Timeout para generación PDF (ms)
ADAPT_PDF_TIMEOUT_MS=60000

# ==========================================
# USER AGENT (scrapers)
# ==========================================
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36