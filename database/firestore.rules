rules_version = '2';

// job-agent: el frontend NUNCA habla con Firestore directamente y el
// backend usa Firebase Admin SDK (que omite estas reglas).
// Estrategia: denegar todo por defecto. Si en el futuro se agrega
// Auth de Firebase para lectura del propio usuario, abrir solo lo
// indicado abajo (actualmente comentado a proposito).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
